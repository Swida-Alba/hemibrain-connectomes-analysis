empty_network/
cache/
comparison_output/
dev/
scripts_local/
local_data/

# App-owned neuron indexes ("system files").  ``neuron_indexes/*`` ignores
# every dataset folder, so pull-built indexes for any current or future
# dataset stay untracked automatically.  The bundled seeds for male-cns v1.0,
# FAFB v783, and BANC v888 are the only re-includes; shipping a NEW seed
# requires adding its re-include lines here (plus the seed files themselves).
neuron_indexes/*
!neuron_indexes/manifest.json
!neuron_indexes/male-cns_v1_0/
!neuron_indexes/male-cns_v1_0/neuron_index.parquet
!neuron_indexes/male-cns_v1_0/neuron_index_search.parquet
!neuron_indexes/flywire_FAFB_v783/
!neuron_indexes/flywire_FAFB_v783/neuron_index.parquet
!neuron_indexes/flywire_FAFB_v783/neuron_index_search.parquet
!neuron_indexes/flywire_BANC_v888/
!neuron_indexes/flywire_BANC_v888/neuron_index.parquet
!neuron_indexes/flywire_BANC_v888/neuron_index_search.parquet

# Raw ROI-sensitive segmentation downloads and generated visualizations.
# Keep the reproducibility plan under version control while ignoring the
# potentially large API artifacts.
preliminary_ROI_sensitive_segmentation/*
!preliminary_ROI_sensitive_segmentation/plan.md

# Deprecated folders (removed November 2025)
navis_roi_meshes_json/

